{
  "name": "class-manager-desktop",
  "productName": "班主任工作台",
  "version": "1.1.0",
  "description": "班主任工作台 · 桌面版（数据全本地）",
  "author": "chee",
  "copyright": "© 2026 chee · 班主任工作台 · 保留所有权利",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "build": "node build.js",
    "start": "electron .",
    "dist": "electron-builder --win",
    "smoke": "cross-env CM_SMOKE=1 electron ."
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.chee.classmanager",
    "productName": "班主任工作台",
    "copyright": "© 2026 chee · 班主任工作台 · 保留所有权利",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "out",
      "buildResources": "icon"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**",
      "icon/**",
      "src/ed25519.cjs",
      "src/pro.core.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "班主任工作台",
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "cheeeom",
      "repo": "class-manager-desktop"
    }
  },
  "baseWeb": "v3.4.0",
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
